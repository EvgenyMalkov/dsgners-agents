# Скопируй в .env и заполни. .env никогда не коммитится.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Твой Telegram ID (бот покажет его на /start). Несколько — через запятую.
OWNER_IDS=

MODEL=claude-sonnet-5-5
# Цена модели за 1 млн токенов, $ (вход / выход) — для учёта расходов
PRICE_IN=2
PRICE_OUT=10
# Сильная модель для контент-плана, текстов статей и месячного разбора (и её цены)
MODEL_SMART=claude-opus-5-5
PRICE_IN_SMART=4
PRICE_OUT_SMART=20
MONTHLY_LIMIT_USD=50

# ИИ-офис: секретный токен (install.sh создаёт сам) и порт
OFFICE_TOKEN=
OFFICE_PORT=8080

# SEO-мониторинг (каждый час / 30 мин / день / неделю). 0 — выключить
SEO_MONITOR=1
SEO_SITE=dsgners.ru
# Какие адреса считать статьями (регулярка). Пусто — по умолчанию /<автор>/<номер>-<адрес>.
SEO_CONTENT_PATTERN=
# Сколько новых статей в день SEO-агент оформляет автоматически (каждая ≈ несколько центов API)
SEO_AUTO_OPTIMIZE_PER_DAY=10
# Скорость обхода сайта, запросов в секунду
SEO_CRAWL_RPS=1.5
# Яндекс: OAuth-токен с правами на Вебмастер и Метрику, номер счётчика Метрики
YANDEX_OAUTH_TOKEN=
METRIKA_COUNTER_ID=
# IndexNow: ключ; файл https://dsgners.ru/<ключ>.txt с этим ключом внутри должен лежать на сайте
INDEXNOW_KEY=

# Поиск в интернете для SEO-агента (анализ конкурентов). Включается в console.anthropic.com; 0 — выключить
WEB_SEARCH=1
# Контент-план по вторникам: сколько тем; 1 — планы статей из контент-плана принимаются без согласования
SEO_TOPICS_PER_WEEK=5
SEO_AUTO_PLANS=0
# Профили редакции: их статьи агент обновляет; статьи остальных авторов — SEO-поля + рекомендации автору
SEO_OWN_AUTHORS=dsgners_study
# API сайта (docs/site-api.md): после «Ок» SEO-поля пишутся на сайт, письма авторам уходят сами
SITE_API_URL=
SITE_API_TOKEN=
# Массовое оформление старых статей (/seo_bulk): статей в час и модель (пусто — MODEL)
SEO_BULK_PER_HOUR=40
SEO_BULK_MODEL=

# Figma (только чтение): токен из Settings → Security → Personal access tokens, право File content: read
# FIGMA_FILES — какие файлы видят агенты: метка:ключ (ключ — часть ссылки figma.com/design/КЛЮЧ/…)
FIGMA_TOKEN=
FIGMA_FILES=dev:,brand:mOEJGc0jVc8yhLsuvEVi8M
# Автопилот SEO-агента (сам берёт задачи): 0 — выкл. Переключается в боте /seo_auto on|off
SEO_AUTOPILOT=0
